{
  "name": "@tamenchan-trainer/content",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./patterns": "./src/patterns/index.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "gen:content": "tsx scripts/sync-markdown.ts",
    "gen:content:watch": "tsx scripts/sync-markdown.ts --watch"
  },
  "dependencies": {
    "@pai-forge/riichi-mahjong": "0.3.6"
  },
  "devDependencies": {
    "@tamenchan-trainer/eslint-config-custom": "workspace:*",
    "eslint": "^9.17.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.18.0"
  }
}
