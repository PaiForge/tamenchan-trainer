{
  "name": "tamenchan-trainer-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run start",
    "android": "turbo run android",
    "ios": "turbo run ios",
    "web": "turbo run web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "gen:content": "turbo run gen:content",
    "gen:content:watch": "turbo run gen:content:watch",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.4.2",
    "turbo": "^2.4.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "volta": {
    "node": "24.12.0"
  }
}
